rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUnderSizeMB(maxMB) {
      return request.resource.size < maxMB * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isAllowedProductFile() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType == 'application/zip' ||
             request.resource.contentType == 'application/x-zip-compressed';
    }

    // ============================================
    // FOTOS DE PERFIL — ADICIONADO
    // ============================================
    match /profile_photos/{userId}/{fileName} {
      allow read:   if true;
      allow write:  if isOwner(userId) &&
                       isImage() &&
                       isUnderSizeMB(5);
      allow delete: if isOwner(userId);
    }

    // ============================================
    // VERIFICAÇÃO DE IDADE — documento + selfie
    // ============================================
    // Três arquivos: doc_front, doc_back, selfie.
    //
    // LEITURA NEGADA A TODOS, inclusive ao dono: depois de
    // enviar, ninguém baixa a imagem pelo app. O admin vê por
    // URL assinada de 10 minutos, gerada por Cloud Function.
    //
    // Storage Rules NÃO leem o Firestore, então a checagem de
    // superadmin não pode viver aqui — é a CF que autoriza.
    //
    // Os arquivos são APAGADOS pelo Admin SDK na aprovação e
    // na rejeição: documento de identidade guardado
    // indefinidamente é passivo, não ativo.
    match /age_verification/{userId}/{fileName} {
      allow read:   if false;
      allow write:  if isOwner(userId) &&
                       isImage() &&
                       isUnderSizeMB(8);
      allow delete: if false;
    }

    // ============================================
    // MÍDIA DO USUÁRIO
    // ============================================
    match /users/{userId}/media/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isOwner(userId) &&
                       isUnderSizeMB(50);
      allow delete: if isOwner(userId);
    }

    // ============================================
    // MARKETPLACE — PRODUTOS
    // ============================================

    // Capa do produto — pública
    match /marketplace/products/{productId}/cover/{fileName} {
      allow read:   if true;
      allow write:  if isAuthenticated() &&
                       isImage() &&
                       isUnderSizeMB(10);
      allow delete: if isAuthenticated();
    }

    // Previews — públicos
    match /marketplace/products/{productId}/previews/{fileName} {
      allow read:   if true;
      allow write:  if isAuthenticated() &&
                       isUnderSizeMB(20);
      allow delete: if isAuthenticated();
    }

    // Preview files — públicos (demos/amostras)
    match /marketplace/products/{productId}/previewFiles/{fileName} {
      allow read:   if true;
      allow write:  if isAuthenticated() &&
                       isAllowedProductFile() &&
                       isUnderSizeMB(50);
      allow delete: if isAuthenticated();
    }

    // Arquivos pagos — SOMENTE upload autenticado
    // Leitura via Cloud Function (getSignedUrl) — nunca direto
    match /marketplace/products/{productId}/files/{fileName} {
      allow read:   if false;
      allow write:  if isAuthenticated() &&
                       isAllowedProductFile() &&
                       isUnderSizeMB(500);
      allow delete: if isAuthenticated();
    }

    // ============================================
    // TUDO MAIS — BLOQUEADO
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
