rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isUnderSizeMB(maxMB) {
      return request.resource.size < maxMB * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isAllowedProductFile() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf' ||
             request.resource.contentType == 'application/zip' ||
             request.resource.contentType == 'application/x-zip-compressed';
    }

    // Prévia é PÚBLICA: sem zip, que poderia carregar executável
    // servido com a marca do Lumina.
    function isAllowedPreviewFile() {
      return request.resource.contentType.matches('image/.*') ||
             request.resource.contentType.matches('video/.*') ||
             request.resource.contentType.matches('audio/.*') ||
             request.resource.contentType == 'application/pdf';
    }

    // Dono do produto, conferido no Firestore (firestore.get lê com a
    // conta de serviço do Storage, fora das Firestore Rules).
    //
    // - O app cria o documento ANTES de subir capa e arquivos
    //   (CreateProductScreen), então o dono já está gravado.
    // - Produto inexistente: o get falha e a regra nega.
    // - isBlocked = ban temporário do MARKETPLACE: durante o ban a
    //   criadora não envia arquivo novo.
    // Custo: 2 leituras por upload. Downloads não passam por aqui.
    function canUploadToProduct(productId) {
      let product = firestore.get(/databases/(default)/documents/products/$(productId));
      let uploader = firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
      return product.data.ownerId == request.auth.uid &&
             product.data.isDeleted != true &&
             uploader.data.isBlocked != true;
    }

    // ============================================
    // FOTOS DE PERFIL
    // ============================================
    match /profile_photos/{userId}/{fileName} {
      allow read:   if true;
      allow write:  if isOwner(userId) &&
                       isImage() &&
                       isUnderSizeMB(5);
      allow delete: if isOwner(userId);
    }

    // ============================================
    // VERIFICAÇÃO DE IDADE — documento + selfie
    // ============================================
    // Três arquivos: doc_front, doc_back, selfie.
    //
    // LEITURA NEGADA A TODOS, inclusive ao dono: depois de
    // enviar, ninguém baixa a imagem pelo app. O admin vê por
    // URL assinada de 10 minutos, gerada por Cloud Function,
    // que é quem confere o superadmin.
    //
    // Os arquivos são APAGADOS pelo Admin SDK na aprovação e
    // na rejeição: documento de identidade guardado
    // indefinidamente é passivo, não ativo.
    match /age_verification/{userId}/{fileName} {
      allow read:   if false;
      allow write:  if isOwner(userId) &&
                       isImage() &&
                       isUnderSizeMB(8);
      allow delete: if false;
    }

    // ============================================
    // MÍDIA DO USUÁRIO
    // ============================================
    // PENDENTE (auditoria M3): qualquer tipo até 50 MB e leitura por
    // qualquer conta. Restringir depois de mapear quem usa.
    match /users/{userId}/media/{fileName} {
      allow read:   if isAuthenticated();
      allow write:  if isOwner(userId) &&
                       isUnderSizeMB(50);
      allow delete: if isOwner(userId);
    }

    // ============================================
    // MARKETPLACE — PRODUTOS
    // ============================================
    // Regras comuns aos quatro caminhos:
    // - Só o DONO do produto envia (canUploadToProduct).
    // - Só CRIAR, nunca sobrescrever: os nomes são únicos
    //   (Date.now()); sobrescrever trocaria conteúdo aprovado, que os
    //   compradores pagaram, sem passar pela moderação.
    // - Ninguém apaga pelo app: quem decide o que pode sumir é o
    //   servidor (unpublishProduct, moderação), pelo Admin SDK.

    // ECA Digital (13/10/2026): capa, prévias e amostras NÃO podem
    // mais ser LISTADAS (antes `read` liberava get e list: sabendo o
    // id do produto, dava para enumerar as imagens). Continua o get
    // por link: os links das capas já gravados (com e sem token) são
    // usados pelo <Image> do app, que não manda login. Quem chega ao
    // link é quem leu o produto — e o produto agora exige idade
    // verificada nas regras do Firestore. Fase B (backlog): links
    // assinados de curta duração e leitura fechada.

    // Capa — link público, sem listagem
    match /marketplace/products/{productId}/cover/{fileName} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuthenticated() &&
                       isImage() &&
                       isUnderSizeMB(10) &&
                       canUploadToProduct(productId);
      allow update, delete: if false;
    }

    // Prévias em imagem — link público, sem listagem
    match /marketplace/products/{productId}/previews/{fileName} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuthenticated() &&
                       isImage() &&
                       isUnderSizeMB(10) &&
                       canUploadToProduct(productId);
      allow update, delete: if false;
    }

    // Arquivos de amostra — link público, sem listagem
    match /marketplace/products/{productId}/previewFiles/{fileName} {
      allow get:    if true;
      allow list:   if false;
      allow create: if isAuthenticated() &&
                       isAllowedPreviewFile() &&
                       isUnderSizeMB(50) &&
                       canUploadToProduct(productId);
      allow update, delete: if false;
    }

    // Arquivos pagos — leitura só por URL assinada (getSignedUrl)
    match /marketplace/products/{productId}/files/{fileName} {
      allow read:   if false;
      allow create: if isAuthenticated() &&
                       isAllowedProductFile() &&
                       isUnderSizeMB(500) &&
                       canUploadToProduct(productId);
      allow update, delete: if false;
    }

    // ============================================
    // SUPORTE — prints anexados aos chamados
    // ============================================
    // Leitura só por URL assinada (getSupportAttachmentUrl), para o
    // dono e para a administração.
    match /support/{userId}/{fileName} {
      allow read:   if false;
      allow create: if isOwner(userId) && isImage() && isUnderSizeMB(5);
      allow update, delete: if false;
    }

    // ============================================
    // TUDO MAIS — BLOQUEADO
    // ============================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

  }
}
