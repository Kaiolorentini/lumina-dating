rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function isNotBlocked() {
      return isAuthenticated() && getUserData().isBlocked != true;
    }

    function isCreator() {
      return isAuthenticated() && isNotBlocked() &&
        getRole() in ['creator', 'admin', 'superadmin'];
    }

    function isAdmin() {
      return isAuthenticated() && isNotBlocked() &&
        getRole() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && isNotBlocked() &&
        getRole() == 'superadmin';
    }

    function hasActivePurchase(productId) {
      let purchaseId = request.auth.uid + '_' + productId;
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/purchases/$(purchaseId)) &&
        get(/databases/$(database)/documents/purchases/$(purchaseId)).data.status == 'active' &&
        get(/databases/$(database)/documents/purchases/$(purchaseId)).data.isRevoked != true;
    }

    function isMarketplaceEnabled() {
      return get(/databases/$(database)/documents/appSettings/config).data.marketplaceEnabled == true &&
        get(/databases/$(database)/documents/appSettings/config).data.maintenanceMode != true;
    }

    function hasNoProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role', 'isBlocked', 'blockedReason', 'blockedAt', 'blockedBy',
        'screenshotWarnings', 'screenshotWarningStatus', 'adminFlags', 'creatorStatus',
      ]);
    }

    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated();
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.isBlocked == false;
      allow update: if isOwner(userId) && hasNoProtectedFields();
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // ============================================
    // SISTEMA DE MOEDAS
    // ============================================
    match /wallets/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // CHATS E MENSAGENS
    // ============================================
    match /chats/{chatId} {
      allow read, write: if isAuthenticated();

      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update: if isAuthenticated() &&
          resource.data.senderId == request.auth.uid;
        allow delete: if false;
      }

      match /typing/{userId} {
        allow read, write: if isAuthenticated();
      }
    }

    // ============================================
    // NOTIFICAÇÕES
    // ============================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // ============================================
    // SOLICITAÇÕES DE CONEXÃO
    // ============================================
    match /connectionRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.fromUserId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.toUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ============================================
    // BLOQUEIOS
    // ============================================
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      allow create: if isAuthenticated() &&
        request.resource.data.blockerId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ============================================
    // VISITAS DE PERFIL
    // ============================================
    match /profile_visits/{visitId} {
      allow read, write: if isAuthenticated();
    }

    match /profile_visit_counts/{profileId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ============================================
    // MEDIA ITEMS
    // ============================================
    match /mediaItems/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.uploadedBy == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.uploadedBy == request.auth.uid;
      allow delete: if isAuthenticated() && (
        resource.data.uploadedBy == request.auth.uid || isAdmin()
      );
    }

    // ============================================
    // UNLOCKED CONTENT
    // ============================================
    match /unlockedContent/{contentId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // AUTO MESSAGES
    // ============================================
    match /autoMessages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // CONNECTIONS
    // ============================================
    match /connections/{connectionId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // MARKETPLACE — PRODUCTS
    // ============================================
    match /products/{productId} {
      allow get: if resource.data.status == 'approved' &&
        resource.data.isDeleted != true;
      allow get: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow list: if resource.data.status == 'approved' &&
        resource.data.isDeleted != true;
      allow list: if isAdmin();
      allow create: if isCreator() && isMarketplaceEnabled() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'draft' &&
        request.resource.data.isFeatured == false;
      allow update: if isCreator() &&
        resource.data.ownerId == request.auth.uid &&
        resource.data.status in ['draft', 'rejected'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'isFeatured', 'ownerId', 'averageRating', 'reviewsCount',
        ]);
      allow delete: if false;

      match /shards/{shardId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && isNotBlocked();
      }
    }

    // ============================================
// MARKETPLACE — CREATOR REQUESTS
// ============================================
match /creatorRequests/{requestId} {
  allow read: if isAuthenticated() && (
    resource.data.userId == request.auth.uid || isAdmin()
  );
  allow create: if isAuthenticated() && isNotBlocked() &&
    request.resource.data.userId == request.auth.uid &&
    request.resource.data.status == 'pending';

  // ✅ Dono cancela (pending → rejected) — apenas campos permitidos
  // Admin pode atualizar qualquer campo
  allow update: if isAuthenticated() && (
    (
      resource.data.userId == request.auth.uid &&
      resource.data.status == 'pending' &&
      request.resource.data.status == 'rejected' &&
      request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'reviewedAt', 'rejectionReason'])
    ) || isAdmin()
  );

  allow delete: if false;
}

    // ============================================
    // MARKETPLACE — SALES
    // ============================================
    match /sales/{saleId} {
      allow get: if isAuthenticated() &&
        resource.data.buyerId == request.auth.uid;
      allow get: if isAuthenticated() &&
        resource.data.sellerId == request.auth.uid;
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — PURCHASES
    // ============================================
    match /purchases/{purchaseId} {
      allow get: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || isAdmin()
      );
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — CREATOR WALLETS
    // ============================================
    match /creatorWallets/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — CREATOR TRANSACTIONS
    // ============================================
    match /creatorTransactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — WITHDRAWALS
    // ============================================
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isCreator() && isNotBlocked() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount > 0;
      allow update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — REVIEWS
    // ============================================
    match /productReviews/{reviewId} {
      allow read: if isAuthenticated() && resource.data.isHidden != true;
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.userId == request.auth.uid &&
        hasActivePurchase(request.resource.data.productId);
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['rating', 'comment', 'isEdited', 'updatedAt']);
      allow delete: if false;
    }

    // ============================================
    // MARKETPLACE — FAVORITES
    // ============================================
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ============================================
    // MARKETPLACE — DOWNLOADS
    // ============================================
    match /downloads/{downloadId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.userId == request.auth.uid &&
        hasActivePurchase(request.resource.data.productId);
      allow update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — REFUND REQUESTS
    // ============================================
    match /refundRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.buyerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.sellerId != request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — FRAUD FLAGS
    // ============================================
    match /fraudFlags/{flagId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — AUDIT LOGS
    // ============================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — SCREENSHOT EVENTS
    // ============================================
    match /screenshotEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — COUPONS
    // ============================================
    match /coupons/{couponId} {
      allow read: if isAuthenticated() && resource.data.isActive == true;
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /couponUses/{useId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — ADMIN METRICS
    // ============================================
    match /adminMetrics/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // APP SETTINGS
    // ============================================
    match /appSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }


    // ============================================
    // MARKETPLACE — PRODUCT ANALYTICS
    // ============================================
    match /productAnalytics/{productId} {
      allow read: if isAuthenticated();

      match /shards/{shardId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && isNotBlocked();
        allow delete: if false;
      }
    }

    // ============================================
    // CONTENT ACCESS LOGS — rate limit
    // ============================================
    match /contentAccessLogs/{userId} {
      allow read, write: if false;

      match /counts/{countId} {
        allow read, write: if false;
      }

      match /minutes/{minuteId} {
        allow read, write: if false;
      }


      // ============================================
// LUMINA — FIRESTORE RULES (ADIÇÕES FASE 0)
// Adicionar ao firestore.rules existente
// ============================================

// Carteira — leitura permitida ao dono, escrita apenas pelo backend
match /wallets/{userId} {
  allow read:  if request.auth != null && request.auth.uid == userId;
  allow write: if false; // somente Cloud Functions via Admin SDK
}

// Audit log financeiro — ninguém lê pelo cliente
match /walletAuditLogs/{logId} {
  allow read:  if false;
  allow write: if false;
}

// Idempotência de earn — somente backend
match /earnIdempotency/{key} {
  allow read:  if false;
  allow write: if false;
}

// Idempotência de spend — somente backend
match /spendIdempotency/{key} {
  allow read:  if false;
  allow write: if false;
}
//trigger
match /triggerControl/{docId} {
  allow read: if false;
  allow write: if false;
}
match /pendingLostSintonia/{docId} {
  allow read: if false;
  allow write: if false;
}
// ============================================
// CHECKLIST FINAL FASE 0
//
// [x] economy.ts — catálogo central de preços
// [x] auditLogFinanceiro.ts — log completo
// [x] initWallet.ts — criação idempotente
// [x] earnCoins.ts — crédito blindado
// [x] spendCoins.ts — débito blindado
// [x] walletService.ts — só leitura + CF calls
// [x] useWallet.ts — onSnapshot + CF spend
// [x] CoinsContext.tsx — spend por feature
// [x] shared/types/index.ts — Wallet v5.0
// [x] Firestore Rules — wallets write: false
//
// REGRAS ANTIFRAUDE COBERTAS:
// [x] CRÍTICO 1  — runTransaction() em earn/spend
// [x] CRÍTICO 2  — timestamps server-side only
// [x] CRÍTICO 3  — idempotência uid+data+tipo
// [x] CRÍTICO 4  — limite diário + mensal server
// [x] CRÍTICO 10 — saldo nunca negativo (HttpsError)
// [x] CRÍTICO 14 — coins separados (gratuito/premium)
// [x] CRÍTICO 19 — ordem de gasto: gratuitos primeiro
// [x] CRÍTICO 15 — auditLog em toda movimentação
//
// PRÓXIMO PASSO: Fase 1 — Cristais de Sintonia
// ============================================
    }

  }
}
