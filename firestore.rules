rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================
    
       // Pré-cadastro da landing — só as Cloud Functions (Admin SDK) leem e escrevem
   match /preRegistrations/{uid} {
     allow read, write: if false;
   }
   match /counters/creatorFounders {
     allow read, write: if false;
   }
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getRole() {
      return getUserData().role;
    }

    function isNotBlocked() {
      return isAuthenticated() && getUserData().isBlocked != true;
    }

    function isCreator() {
      return isAuthenticated() && isNotBlocked() &&
        getRole() in ['creator', 'admin', 'superadmin'];
    }

    function isAdmin() {
      return isAuthenticated() && isNotBlocked() &&
        getRole() in ['admin', 'superadmin'];
    }

    function isSuperAdmin() {
      return isAuthenticated() && isNotBlocked() &&
        getRole() == 'superadmin';
    }

    function hasActivePurchase(productId) {
      let purchaseId = request.auth.uid + '_' + productId;
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/purchases/$(purchaseId)) &&
        get(/databases/$(database)/documents/purchases/$(purchaseId)).data.status == 'active' &&
        get(/databases/$(database)/documents/purchases/$(purchaseId)).data.isRevoked != true;
    }

    function isMarketplaceEnabled() {
      return get(/databases/$(database)/documents/appSettings/config).data.marketplaceEnabled == true &&
        get(/databases/$(database)/documents/appSettings/config).data.maintenanceMode != true;
    }

    // ── Claims de acesso (PARTE 9) ──
    // Gravadas por functions/src/utils/accessClaims.ts e lidas do
    // TOKEN — sem leitura cobrada.
    //   av  = verificação de idade aprovada (ou admin/superadmin)
    //   ban = conta encerrada (accountBanned — não o isBlocked, que
    //         é o ban temporário do marketplace)
    // get() com padrão: claim ausente não pode estourar a regra.
    // O app só entra na árvore principal com a claim no token
    // (hooks/useAccessClaims).
    function isVerified() {
      return isAuthenticated() &&
        request.auth.token.get('av', false) == true &&
        request.auth.token.get('ban', false) != true;
    }

    // Campos que o cliente NUNCA escreve no próprio documento —
    // nem no create, nem no update.
    // role e isBlocked NÃO estão aqui porque o create os EXIGE com
    // valor fixo; no update eles entram via hasNoProtectedFields.
    // A4 (08/10/2026): a proteção principal agora é a lista branca
    // (profileClientFields). Esta lista segue como SEGUNDA barreira
    // no update e como registro dos campos do servidor.
    // randomSeed tem regra própria (isRandomSeedChangeAllowed).
    function clientBlockedUserFields() {
      return [
        // Moderação
        'blockedReason', 'blockedAt', 'blockedBy',
        // Ban temporário de marketplace: sem isto o cliente apaga
        // o prazo no próprio documento e escapa da punição.
        'marketplaceBanUntil', 'previousRole', 'marketplaceBanRestoredAt', 'blockedSource',
        // Onboarding — gravados só pelas CFs de aceite e
        // verificação. Sem isto o cliente se declara maior de
        // idade e verificado escrevendo no próprio documento.
        'acceptedAppTermsVersion', 'acceptedAppTermsAt',
        'ageVerified', 'ageVerifiedAt', 'birthDate',
        'ageVerificationStatus', 'ageRejectionReason', 'ageRejectionNote',
        'screenshotWarnings', 'screenshotWarningStatus', 'adminFlags', 'creatorStatus',
        // Token de push: a coleção users tinha `allow list` aberto,
        // então qualquer conta logada lia o token de todo mundo e
        // mandava push com a marca do Lumina. Agora vive em
        // users/{uid}/private/push e é gravado pela CF
        // registerPushToken.
        'pushToken', 'pushTokenUpdatedAt',
        // Economia — gravados exclusivamente pelas Cloud Functions.
        // Sem isto, qualquer usuário se concede Turbo/Impulso/Destaque
        // permanente com boostScore arbitrário, sem gastar cristais.
        'turbo', 'impulso', 'destaqueRegional',
        'boostActiveUntil', 'boostType', 'regionCount',
        // Progressão — XP, árvore, conquistas, molduras e títulos.
        // FASE 5: sem isto, qualquer conta se concede a moldura
        // Lendária e o frame de Fundador escrevendo direto no
        // próprio documento.
        'progression', 'xp', 'achievements',
        // Recebimento do criador — só pela CF saveCreatorPixKey, e a
        // chave vive em users/{uid}/private/payout.
        'pixKey', 'pixKeyType', 'pixKeyVerifiedAt', 'paymentSetupStatus',
        // Galeria: só pelas CFs, que montam o link a partir do arquivo
        // da própria pasta.
        'gallery',
      ];
    }

    // Update: bloqueia a lista acima + role e isBlocked.
    // affectedKeys() pega campo adicionado, removido ou alterado;
    // reenviar o mesmo valor não conta como alteração.
    function hasNoProtectedFields() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(clientBlockedUserFields().concat(['role', 'isBlocked']));
    }

    // Se vier, randomSeed precisa ser number em [0, 1). String ou
    // valor fora da faixa tira a conta das consultas por faixa do
    // feed, do Sintonize e da Carta do Destino.
    function isValidRandomSeed(data) {
      return !('randomSeed' in data) ||
        (data.randomSeed is number && data.randomSeed >= 0 && data.randomSeed < 1);
    }

    // randomSeed é gravado UMA VEZ. O documento nasce antes do
    // perfil (a CF acceptAppTerms cria users/{uid} no aceite dos
    // termos), então a primeira gravação do seed chega como UPDATE.
    // Permitido só se o documento ainda não tem seed; depois disso
    // fica imutável — regravar permitiria editar o perfil até cair
    // numa posição boa do feed.
    function isRandomSeedChangeAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['randomSeed']) ||
        (!('randomSeed' in resource.data) && isValidRandomSeed(request.resource.data));
    }

    // ── Lista branca do perfil (auditoria A4, 08/10/2026) ──
    // Antes o update era por LISTA NEGRA (hasNoProtectedFields):
    // qualquer campo fora da lista era gravável — photoURL apontando
    // para fora do Storage (foto sem moderação no feed), valores sem
    // limite e campos que o servidor cria no futuro.
    // Agora o cliente só grava estes campos, cada um validado.
    // São EXATAMENTE os que o app envia hoje (useProfileSetup,
    // saveProfile, uploadProfilePhoto) — nenhuma tela muda.
    // Tudo o mais (role, isBlocked, progression, xp, boosts,
    // moderação, termos, verificação, galeria…) é só do servidor.
    function profileClientFields() {
      return [
        'uid', 'email', 'name', 'age', 'city', 'state', 'regiaoId', 'estadoId',
        'gender', 'preferences', 'bio', 'photoURL',
        'createdAt', 'updatedAt', 'randomSeed',
      ];
    }

    // Foto de perfil: só o arquivo da PRÓPRIA pasta, no Storage
    // DESTE projeto (os dois nomes de bucket do Lumina). Bucket de
    // outro projeto com o mesmo caminho não passa.
    function isOwnProfilePhotoUrl(url, userId) {
      return url is string && url.size() <= 1024 &&
        url.matches(
          'https://firebasestorage[.]googleapis[.]com/v0/b/lumina-ff667[.](firebasestorage[.]app|appspot[.]com)/o/profile_photos%2F'
          + userId + '%2Fphoto[.]jpg[?].*'
        );
    }

    // Valida cada campo PRESENTE em `changed`. No update, `changed` é o
    // que mudou (affectedKeys): campo reenviado com o mesmo valor não
    // é revalidado — conta antiga com valor fora do padrão continua
    // editando o resto. No create, `changed` é o documento inteiro.
    // Campo removido também entra em affectedKeys e falha aqui (o
    // valor não existe), então o cliente não apaga campos do perfil.
    function isValidProfileFields(d, changed, userId) {
      return (!changed.hasAny(['uid'])  || d.uid == userId) &&
        (!changed.hasAny(['email'])       || (d.email is string && d.email == request.auth.token.get('email', ''))) &&
        (!changed.hasAny(['name'])        || (d.name is string && d.name.size() >= 1 && d.name.size() <= 80)) &&
        (!changed.hasAny(['age'])         || (d.age is number && d.age >= 18 && d.age <= 100)) &&
        (!changed.hasAny(['city'])        || (d.city is string && d.city.size() >= 1 && d.city.size() <= 100)) &&
        (!changed.hasAny(['state'])       || (d.state is string && d.state.size() == 2)) &&
        (!changed.hasAny(['regiaoId'])    || (d.regiaoId is string && d.regiaoId.matches('[0-9]{7}'))) &&
        (!changed.hasAny(['estadoId'])    || (d.estadoId is number && d.estadoId >= 11 && d.estadoId <= 53)) &&
        (!changed.hasAny(['gender'])      || d.gender in ['masculino', 'feminino', 'trans', 'nao-binario']) &&
        (!changed.hasAny(['preferences']) || (d.preferences is list &&
                                           d.preferences.size() >= 1 && d.preferences.size() <= 4 &&
                                           d.preferences.toSet().hasOnly(['homens', 'mulheres', 'trans', 'todos']))) &&
        (!changed.hasAny(['bio'])         || (d.bio is string && d.bio.size() <= 1000)) &&
        (!changed.hasAny(['photoURL'])    || isOwnProfilePhotoUrl(d.photoURL, userId)) &&
        (!changed.hasAny(['createdAt'])   || d.createdAt is timestamp) &&
        (!changed.hasAny(['updatedAt'])   || d.updatedAt is timestamp);
    }

    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      // Perfil de OUTRA pessoa só para conta verificada (auditoria
      // C2). Antes, qualquer conta logada — inclusive criada na
      // landing em segundos — listava a base inteira de um app
      // adulto: fotos, idade, cidade e campos de moderação.
      // O dono sempre lê o próprio documento: o gate de acesso
      // depende dele antes da verificação.
      allow get: if isOwner(userId) || isVerified() || isAdmin();
      allow list: if isVerified() || isAdmin();
      // O CREATE barra TODOS os campos protegidos, não só os de
      // economia. Antes, uma conta nova podia nascer com
      // ageVerificationStatus 'approved', xp e conquistas
      // arbitrárias — furando o gate de idade inteiro.
      //
      // A4: o create também é por lista branca. Normalmente o
      // documento nasce na CF acceptAppTerms (Admin SDK); o create
      // pelo app só acontece no saveProfile de uma conta sem
      // documento, e ele manda só campos da lista + role/isBlocked.
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'user' &&
        request.resource.data.isBlocked == false &&
        request.resource.data.keys().hasOnly(profileClientFields().concat(['role', 'isBlocked'])) &&
        isValidProfileFields(request.resource.data, request.resource.data.keys(), userId) &&
        isValidRandomSeed(request.resource.data);
      // A4: só campos da lista branca, validados. role, isBlocked e
      // todo campo do servidor ficam fora — inclusive os que forem
      // criados no futuro.
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(profileClientFields()) &&
        hasNoProtectedFields() &&
        isValidProfileFields(request.resource.data,
                             request.resource.data.diff(resource.data).affectedKeys(), userId) &&
        isRandomSeedChangeAllowed();
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Dados que NEM O DONO lê pelo cliente. Hoje guarda o
      // token de push: se o dono pudesse ler, um app modificado
      // leria o próprio e o de outros pela mesma rule.
      // Escrita e leitura só pelo Admin SDK.
      match /private/{docId} {
        allow read:  if false;
        allow write: if false;
      }
    }

    // ============================================
    // CARTEIRA — escrita apenas pelo backend
    // ============================================
    match /wallets/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }

    match /walletAuditLogs/{logId} {
      allow read:  if false;
      allow write: if false;
    }

    // Movimentação em reais da carteira do criador — só o servidor.
    match /creatorWalletLogs/{logId} {
      allow read:  if false;
      allow write: if false;
    }

    match /earnIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }

    match /spendIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }

    // ============================================
    // CHATS E MENSAGENS
    // ============================================
    // chatId = [uidA, uidB].sort().join('_') — determinístico e
    // imutável. Validar por ele custa ZERO leituras e é imune ao
    // bug do participants (setDoc/merge substitui o array e pode
    // remover um membro do próprio chat).
    //
    // isVerified(): conta não verificada ou banida não conversa.
    // A exigência de Sintonia mútua fica para a Parte 3 da auditoria.
    function isChatMember(chatId) {
      return isAuthenticated() && chatId.split('_').hasAny([request.auth.uid]);
    }

    // Chat liberado pelo servidor: pedido aceito (ou Sintonia mútua)
    // e nenhum bloqueio entre os dois. Ver functions/src/social/
    // chatAccess.ts. Uma leitura por avaliação.
    function canUseChat(chatId) {
      return isChatMember(chatId) && isVerified() &&
        exists(/databases/$(database)/documents/chatAccess/$(chatId));
    }

    // Documento do chat: só os metadados que o app grava, e
    // participants restrito aos dois membros do id.
    function isValidChatMeta(chatId) {
      return request.resource.data.keys()
          .hasOnly(['lastMessage', 'lastMessageTime', 'updatedAt', 'participants']) &&
        request.resource.data.get('participants', []).toSet()
          .difference(chatId.split('_').toSet()).size() == 0;
    }

    // Entregue/lida (Parte 5): só quem recebeu marca, e só para true
    // (ninguém "desmarca" a leitura). O markAsDelivered/markAsRead do
    // app já filtra senderId != eu.
    function isValidReceiptChange() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['delivered', 'deliveredAt', 'read', 'readAt']) || (
        resource.data.senderId != request.auth.uid &&
        (!changed.hasAny(['delivered']) || request.resource.data.delivered == true) &&
        (!changed.hasAny(['read'])      || request.resource.data.read == true) &&
        (!changed.hasAny(['deliveredAt']) || request.resource.data.deliveredAt == request.time) &&
        (!changed.hasAny(['readAt'])      || request.resource.data.readAt == request.time)
      );
    }

    // Reações (Parte 5): o mapa reactions só muda na chave de quem
    // reage. Valor: emoji curto. Tirar a própria reação também passa.
    function isValidReactionChange() {
      let before = resource.data.get('reactions', {});
      let after  = request.resource.data.get('reactions', {});
      let uid    = request.auth.uid;
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reactions']) || (
        after is map &&
        after.diff(before).affectedKeys().hasOnly([uid]) &&
        (!after.keys().hasAny([uid]) || (after[uid] is string && after[uid].size() >= 1 && after[uid].size() <= 16))
      );
    }

    match /chatAccess/{chatId} {
      allow read, write: if false;
    }

    match /chats/{chatId} {
      // O documento de chat guarda lastMessage e lastMessageTime —
      // conteúdo de conversa privada. Só quem tem o chat liberado
      // (canUseChat) lê ou escreve.
      allow read:   if canUseChat(chatId);
      allow create: if canUseChat(chatId) && isValidChatMeta(chatId);
      allow update: if canUseChat(chatId) && isValidChatMeta(chatId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canUseChat(chatId);
        allow create: if canUseChat(chatId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.keys().hasOnly([
            'text', 'senderId', 'senderName', 'timestamp',
            'delivered', 'read', 'audioUrl', 'audioDuration',
          ]) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 2000;
        // Parte 5 (decisão 2A, 08/10/2026): texto, áudio, remetente e
        // horário são IMUTÁVEIS depois do envio. Antes o remetente
        // regravava a mensagem inteira (trocar o texto depois que a
        // outra pessoa leu, ou o senderId), e quem RECEBIA não
        // conseguia reagir — a reação era negada.
        // Agora, nos dois lados, só mudam:
        //   - entregue/lida: só por quem RECEBEU, e só para true;
        //   - reações: cada um só a PRÓPRIA (reactions.{uid}).
        allow update: if canUseChat(chatId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['delivered', 'deliveredAt', 'read', 'readAt', 'reactions']) &&
          isValidReceiptChange() &&
          isValidReactionChange();
        allow delete: if false;
      }

      // "Digitando…": só o próprio indicador, só estes dois campos.
      match /typing/{userId} {
        allow read:  if canUseChat(chatId);
        allow write: if canUseChat(chatId) && isOwner(userId) &&
          request.resource.data.keys().hasOnly(['isTyping', 'updatedAt']) &&
          request.resource.data.isTyping is bool &&
          request.resource.data.updatedAt == request.time;
      }
    }
    

    // ============================================
    // NOTIFICAÇÕES
    // ============================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // Antes, qualquer usuário criava notificação para qualquer
      // outro — vetor de phishing dentro do app ("você ganhou
      // 500 cristais, toque aqui").
      // Notificações de sistema vêm do Admin SDK e ignoram Rules.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['read', 'delivered', 'deliveredAt', 'readAt']);
      allow delete: if false;
    }

    // ============================================
    // SOLICITAÇÕES DE CONEXÃO
    // ============================================
    // Criar e aceitar exigem conta verificada. A validação dos
    // campos do pedido (status na criação) fica para a Parte 3.
    match /connectionRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      // Criação: id remetente_destinatário (duplicata vira update e é
      // negada), só os campos conhecidos, sempre 'pending', nunca para
      // si mesmo. 'accepted' só nasce pelo servidor (Sintonia).
      allow create: if isVerified() && isNotBlocked() &&
        requestId == request.auth.uid + '_' + request.resource.data.toUserId &&
        request.resource.data.keys().hasOnly([
          'fromUserId', 'toUserId', 'fromUserName', 'fromUserPhoto', 'status', 'timestamp',
        ]) &&
        request.resource.data.fromUserId == request.auth.uid &&
        request.resource.data.toUserId is string &&
        request.resource.data.toUserId != request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.timestamp == request.time &&
        request.resource.data.fromUserName is string &&
        request.resource.data.fromUserName.size() <= 100 &&
        request.resource.data.fromUserPhoto is string &&
        request.resource.data.fromUserPhoto.size() <= 2048;
      // Resposta: só o destinatário, só saindo de 'pending', só status.
      allow update: if isVerified() &&
        resource.data.toUserId == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // ============================================
    // BLOQUEIOS
    // ============================================
    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (
        resource.data.blockerId == request.auth.uid ||
        resource.data.blockedId == request.auth.uid
      );
      // Parte 5: só os campos que o bloquearUsuario grava. Antes
      // qualquer campo extra passava (documento inchado, dados
      // falsos sobre a outra pessoa).
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly([
          'blockerId', 'blockedId', 'blockedName', 'blockedPhoto', 'timestamp',
        ]) &&
        request.resource.data.blockerId == request.auth.uid &&
        request.resource.data.blockedId is string &&
        request.resource.data.blockedId.size() >= 1 &&
        request.resource.data.blockedId.size() <= 128 &&
        request.resource.data.blockedId != request.auth.uid &&
        request.resource.data.blockedName is string &&
        request.resource.data.blockedName.size() <= 200 &&
        request.resource.data.blockedPhoto is string &&
        request.resource.data.blockedPhoto.size() <= 2048 &&
        request.resource.data.timestamp == request.time;
      allow delete: if isAuthenticated() &&
        resource.data.blockerId == request.auth.uid;
      allow update: if false;
    }

    // ============================================
    // VISITAS DE PERFIL
    // ============================================
    // Escrita exclusiva da CF registerProfileVisit (Admin SDK).
    // A lista de visitantes é servida por getVisitorsStatus, que
    // exige acesso pago — por isso a leitura direta fica fechada.
    match /profile_visits/{visitId} {
      allow read:  if false;
      allow write: if false;
    }

    // Contadores alimentam a aba "Em Alta". Escrita livre permitia
    // inflar o próprio contador e ocupar o topo sem pagar —
    // canibalizando Turbo, Impulso e Destaque Regional.
    // Incremento deve vir de Cloud Function (R13: usuários únicos,
    // não eventos).
    match /profile_visit_counts/{profileId} {
      allow read:  if isVerified();
      allow write: if false;
    }
// ============================================
    // VER VISITANTES — acesso pago (somente backend escreve)
    // ============================================
    match /visitorsAccess/{uid} {
      allow read:  if isAuthenticated() && isOwner(uid);
      allow write: if false;
    }

    match /premiumUsageLog/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    match /premiumAnalytics/{docId} {
      allow read:  if false;
      allow write: if false;
    }
    // ============================================
    // CURTIDAS
    // ============================================
    match /likes/{likeId} {
      // Escrita exclusiva da CF onCreateMatch (Admin SDK ignora rules).
      // A rule antiga validava `likerUid`, campo que a CF nem grava —
      // o caminho antigo do cliente seguia aberto: dava para forjar a
      // curtida pelo SDK sem passar pelo MatchService.
      //
      // `resource == null` é obrigatório: o checkAlreadyLiked faz get
      // de um documento que pode não existir (mesma armadilha que
      // quebrou favorites).
      //
      // get('likerUid', '') cobre os documentos legados, gravados pelo
      // cliente antes da v2 com o nome de campo antigo.
      allow get: if isAuthenticated() && (
        resource == null ||
        resource.data.get('fromUid',  '') == request.auth.uid ||
        resource.data.get('likerUid', '') == request.auth.uid
      );
      allow list: if false;
      allow create, update, delete: if false;
    }

    // ============================================
    // MEDIA ITEMS
    // ============================================
    // Fechada na Parte 5 (decisão 1A, 08/10/2026): a tela Mídia saiu
    // do app (não estava em nenhum navegador). A coleção aceitava
    // link de imagem de fora (ImgBB) sem moderação, visível para
    // toda conta verificada. Documentos antigos ficam onde estão,
    // inacessíveis ao cliente.
    match /mediaItems/{itemId} {
      allow read, write: if false;
    }

    // ============================================
    // UNLOCKED CONTENT
    // ============================================
    // Coleção sem uso: nem o app nem as funções leem ou gravam
    // (auditoria A3). Fechada nos dois sentidos.
    match /unlockedContent/{contentId} {
      allow read, write: if false;
    }

    // ============================================
    // AUTO MESSAGES
    // ============================================
    match /autoMessages/{messageId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ============================================
    // CONNECTIONS
    // ============================================
    // Coleção sem uso: as conexões vivem em connectionRequests
    // (auditoria A3). Fechada nos dois sentidos.
    match /connections/{connectionId} {
      allow read, write: if false;
    }

    // ============================================
    // MARKETPLACE — PRODUCTS
    // ============================================
    // Vitrine pública por decisão de produto (auditoria M7): a
    // moderação garante capa e prévia sem nudez.
    // Preço de produto: grátis (0) ou pago a partir de R$ 19,99. A
    // taxa do Pix (R$ 1,99) tornava a venda barata um prejuízo.
    function isAllowedProductPrice(price) {
      return price is number && (price == 0 || price >= 19.99);
    }

    // Os 20 campos que o createProduct do app grava (Parte 5).
    function productCreateFields() {
      return [
        'ownerId', 'title', 'description', 'price', 'isFree', 'category', 'tags',
        'status', 'coverImage', 'previewImages', 'previewFiles', 'files',
        'isFeatured', 'isDeleted', 'averageRating', 'reviewsCount',
        'version', 'changelog', 'createdAt', 'updatedAt',
      ];
    }

    match /products/{productId} {
      allow get: if resource.data.status == 'approved' &&
        resource.data.isDeleted != true;
      allow get: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      // Quem comprou lê o produto mesmo depois de tirado da venda.
      allow get: if hasActivePurchase(productId);
      allow list: if resource.data.status == 'approved' &&
        resource.data.isDeleted != true;
      allow list: if isAdmin();
      // Meus Produtos: o dono lista os próprios produtos em qualquer
      // status. A busca precisa filtrar ownerId == uid; sem esse
      // filtro a regra não se confirma e a consulta é recusada.
      allow list: if isAuthenticated() &&
        resource.data.ownerId == request.auth.uid;
      // Parte 5: create por LISTA BRANCA — exatamente os 20 campos do
      // createProduct do app, com os valores iniciais fixos. Antes
      // qualquer campo extra passava (hasPendingChanges, pendingCover,
      // coverStoragePath, files já preenchido…). Capa, prévias e
      // arquivos entram depois, pelo update de rascunho.
      allow create: if isCreator() && isMarketplaceEnabled() &&
        request.resource.data.keys().hasOnly(productCreateFields()) &&
        request.resource.data.keys().hasAll(productCreateFields()) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 200 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 5000 &&
        request.resource.data.price is number &&
        request.resource.data.price >= 0 &&
        request.resource.data.price <= 100000 &&
        // Preço mínimo (09/10/2026): grátis ou a partir de R$ 19,99.
        // Mesmo valor de functions/src/config/marketplacePricing.ts.
        isAllowedProductPrice(request.resource.data.price) &&
        request.resource.data.isFree == (request.resource.data.price == 0) &&
        request.resource.data.category is string &&
        request.resource.data.category.size() >= 1 &&
        request.resource.data.category.size() <= 50 &&
        request.resource.data.tags is list &&
        request.resource.data.tags.size() <= 50 &&
        request.resource.data.status == 'draft' &&
        request.resource.data.coverImage == '' &&
        request.resource.data.previewImages == [] &&
        request.resource.data.previewFiles == [] &&
        request.resource.data.files == [] &&
        request.resource.data.isFeatured == false &&
        request.resource.data.isDeleted == false &&
        // Nota e contagem só pela CF submitProductReview.
        request.resource.data.averageRating == 0 &&
        request.resource.data.reviewsCount == 0 &&
        request.resource.data.version == 1 &&
        request.resource.data.changelog == '' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      // Edição normal: o dono altera conteúdo, nunca status nem
      // campos de curadoria.
      allow update: if isCreator() &&
        resource.data.ownerId == request.auth.uid &&
        resource.data.status in ['draft', 'rejected'] &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'isFeatured', 'ownerId', 'averageRating', 'reviewsCount',
          'ratingSum', 'ratingUpdatedAt',
          // Retirada e moderação de alterações: só pelas CFs.
          'isDeleted', 'deletedAt', 'hasPendingChanges', 'pendingCover', 'lastChangesRejection',
          // Parte 5: versão e caminho da capa no Storage são do
          // servidor (aprovação de alterações).
          'version', 'coverStoragePath', 'createdAt',
          // 12/10/2026: Declaração do Produto — só o servidor grava
          // (submitProductForReview / submitProductChanges).
          'declarationId', 'declarationVersion', 'submittedAt',
          'pendingChangesDeclarationId', 'pendingChangesDeclarationVersion',
        ]) &&
        // Preço editado no rascunho também respeita o mínimo.
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['price']) ||
          isAllowedProductPrice(request.resource.data.price));

      // Envio para revisão (draft/rejected → pending): desde 12/10/2026
      // SÓ pela CF submitProductForReview, que exige o Contrato do
      // Criador aceito e grava a Declaração do Produto na mesma
      // transação. A regra antiga deixava o app mudar o status direto,
      // o que pularia a declaração. O trigger onProductPending continua
      // avisando os admins (dispara com a gravação do servidor).
      allow delete: if false;

      // A subcollection products/{id}/shards não existe — todo o
      // código de analytics escreve em productAnalytics/{id}/shards.
      // A rule aberta aqui era porta para uma collection fantasma.
    }

    // ============================================
    // MARKETPLACE — CREATOR REQUESTS
    // ============================================
    match /creatorRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Parte 5: só os 3 campos do createCreatorRequest. Antes dava
      // para criar o pedido já com reviewedBy, rejectionReason ou
      // createdAt no passado (furando a ordem da fila do admin).
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.keys().hasOnly(['userId', 'status', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt == request.time;
      allow update: if isAuthenticated() && (
        (
          resource.data.userId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'rejected' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'reviewedAt', 'rejectionReason'])
        ) || isAdmin()
      );
      allow delete: if false;
    }

    // ============================================
    // MARKETPLACE — SALES
    // ============================================
    match /sales/{saleId} {
      allow get: if isAuthenticated() &&
        resource.data.buyerId == request.auth.uid;
      allow get: if isAuthenticated() &&
        resource.data.sellerId == request.auth.uid;
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
match /coinsPurchases/{docId} {
  allow read: if isAuthenticated() &&
    resource.data.uid == request.auth.uid;
  allow write: if false;
}
    // ============================================
    // MARKETPLACE — PURCHASES
    // ============================================
    // Criadas só pelas CFs de compra, que exigem conta verificada.
    match /purchases/{purchaseId} {
      allow get: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || isAdmin()
      );
      allow list: if isAuthenticated() &&
        resource.data.buyerId == request.auth.uid;
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — CREATOR WALLETS
    // ============================================
    match /creatorWallets/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // PAINEL DO CRIADOR — resumo de vendas e notas
    // ============================================
    // Gravado SÓ pelos gatilhos de functions/src/creators/
    // creatorStats.ts. Dado financeiro: só o dono e o admin leem.
    // As marcas internas (saleMarks, ratingMarks) ficam fechadas.
    match /creatorStats/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;

      match /{subcollection}/{docId} {
        allow read, write: if false;
      }
    }

    // ============================================
    // MARKETPLACE — CREATOR TRANSACTIONS
    // ============================================
    match /creatorTransactions/{transactionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — WITHDRAWALS
    // ============================================
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // Só pela CF requestWithdrawal: chave cadastrada, mínimo, saldo e
      // dívida conferidos numa transação.
      allow create: if false;
      allow update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — REVIEWS
    // ============================================
   // Avaliações — gravadas SÓ pelas CFs de
    // functions/src/products/productReviews.ts (nota 1–5, comentário
    // até 500 sem contatos, compra ativa e conteúdo já aberto, média
    // do produto na mesma transaction).
    match /productReviews/{reviewId} {
      // Lista pública do produto: só as não ocultas. A busca do app
      // já filtra isHidden == false, então a regra se confirma.
      allow list: if isAuthenticated() && resource.data.isHidden != true;
      // Leitura de um documento: não ocultas, ou a PRÓPRIA avaliação
      // (o autor vê que o comentário foi ocultado e pode editar).
      allow get: if isAuthenticated() && (
        resource.data.isHidden != true ||
        resource.data.userId == request.auth.uid
      );
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — FAVORITES
    // ============================================
    match /favorites/{favoriteId} {
      // resource é null quando o documento não existe. Sem o guard,
      // resource.data.userId estoura e o Firestore nega — quebrando
      // a leitura de idempotência do addFavorite, que checa a
      // existência ANTES de criar. Só dava para favoritar o que já
      // estava favoritado.
      allow get: if isAuthenticated() &&
        (resource == null || resource.data.userId == request.auth.uid);
      allow list: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      // Parte 5: id = {uid}_{productId} (o mesmo do app — um favorito
      // por produto) e só os 3 campos do addFavorite.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['userId', 'productId', 'createdAt']) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.productId is string &&
        request.resource.data.productId.size() >= 1 &&
        request.resource.data.productId.size() <= 128 &&
        favoriteId == request.auth.uid + '_' + request.resource.data.productId &&
        request.resource.data.createdAt == request.time;
      allow delete: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // ============================================
    // MARKETPLACE — DOWNLOADS
    // ============================================
    match /downloads/{downloadId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && isNotBlocked() &&
        request.resource.data.userId == request.auth.uid &&
        hasActivePurchase(request.resource.data.productId);
      allow update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — REFUND REQUESTS
    // ============================================
    match /refundRequests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid || isAdmin()
      );
      // Só pela CF requestRefund (prazo de 7 dias e chave Pix validada).
      allow create: if false;
      allow update, delete: if false;
    }

    // ============================================
    // SUPORTE — escrita só pelas CFs de supportTickets
    // ============================================
    // Sem isVerified() de propósito: quem ainda está na verificação
    // também precisa conseguir pedir ajuda.
    match /supportTickets/{ticketId} {
      allow read: if isAuthenticated() &&
        (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid ||
          isAdmin()
        );
        allow write: if false;
      }
    }

    // Relatórios mensais escritos — gerados pelo resetMonthlyMetrics.
    match /adminReports/{monthId} {
      allow read:  if isAuthenticated() && isAdmin();
      allow write: if false;
    }

    // ============================================
    // MARKETPLACE — FRAUD FLAGS
    // ============================================
    match /fraudFlags/{flagId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // AUDIT LOGS
    // ============================================
    match /auditLogs/{logId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — SCREENSHOT EVENTS
    // ============================================
    match /screenshotEvents/{eventId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ============================================
    // MARKETPLACE — COUPONS
    // ============================================
    // Parte 5 (auditoria M5, 08/10/2026): o cupom é validado só no
    // servidor (validateCoupon / buildPurchasePricing) — o app nunca
    // lê a coleção fora do painel do admin. Antes qualquer conta
    // verificada LISTAVA todos os cupons ativos, inclusive os
    // privados de campanha.
    // Escrita: só pelas CFs createCoupon/updateCoupon/toggleCoupon,
    // que já registram auditoria.
    match /coupons/{couponId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Uso de cupom: ninguém do app grava (o servidor registra o uso
    // na compra). Antes qualquer conta criava documentos aqui.
    match /couponUses/{useId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // ADMIN METRICS
    // ============================================
    match /adminMetrics/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Períodos fechados dos contadores de adminMetrics. Escrita
    // exclusiva dos jobs de reset (Admin SDK ignora rules).
    match /metricsHistory/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ============================================
    // GALÁXIA PLUS — escrita exclusiva do backend
    // ============================================
    // O dono lê para ver o prazo e o consumo dos benefícios na
    // tela. Escrita fechada: o documento guarda a data de
    // expiração, e um cliente que pudesse escrever estenderia o
    // próprio acesso de graça.
    match /galaxiaPlus/{userId} {
      allow read:  if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }

    // ============================================
    // PRESTÍGIO — escrita exclusiva do backend
    // ============================================
    // O prestígio é concedido pelo PrestigeService, chamado
    // pelas CFs nos pontos onde o marco realmente acontece.
    // A callable `grantPrestigePoints` foi REMOVIDA: ela
    // aceitava qualquer marcoId do cliente, então dava para
    // pedir ACH_FOUNDER (500 pontos) sem nunca ter sido
    // fundador.
    match /prestige/{userId} {
      allow read:  if isAuthenticated() && isOwner(userId);
      allow write: if false;
    }

    match /prestigeLog/{logId} {
      allow read:  if false;
      allow write: if false;
    }

    match /prestigeAnalytics/{docId} {
      allow read:  if false;
      allow write: if false;
    }

        // ============================================
    // MONITOR DE INFLAÇÃO — snapshots diários
    // Leitura restrita a superadmin (mesma regra da CF)
    // ============================================
    match /economySnapshots/{docId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ============================================
    // APP SETTINGS
    // ============================================
    match /appSettings/{docId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    // ============================================
    // PRODUCT ANALYTICS
    // ============================================
    match /productAnalytics/{productId} {
      allow read: if isAuthenticated();

      match /shards/{shardId} {
        allow read: if isAuthenticated();
        // Escrita direta do cliente é intencional: uma CF por view
        // custaria uma invocação a cada abertura de produto, e estes
        // contadores são informativos — não movem ranking nem dinheiro.
        // O hasOnly impede escrita arbitrária no documento; não impede
        // quem insista em chamar o incremento muitas vezes.
        // Se um dia views influenciarem posição no marketplace, isto
        // precisa virar Cloud Function.
        // Parte 5: só incremento de 1 por gravação (views +1,
        // favorites ±1) e shard novo começando em 0 ou 1. Antes o
        // cliente gravava qualquer número (views: 999999).
        // downloads é só do servidor.
        allow create: if isAuthenticated() && isNotBlocked() &&
          request.resource.data.keys().hasOnly(['views', 'downloads', 'favorites']) &&
          request.resource.data.get('views', 0) in [0, 1] &&
          request.resource.data.get('downloads', 0) == 0 &&
          request.resource.data.get('favorites', 0) in [0, 1];
        allow update: if isAuthenticated() && isNotBlocked() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['views', 'favorites']) &&
          request.resource.data.get('views', 0) is number &&
          request.resource.data.get('favorites', 0) is number &&
          (request.resource.data.get('views', 0) - resource.data.get('views', 0)) in [0, 1] &&
          (request.resource.data.get('favorites', 0) - resource.data.get('favorites', 0)) in [-1, 0, 1];
        allow delete: if false;
      }
    }

    // ============================================
    // CONTENT ACCESS LOGS — somente backend
    // ============================================
    match /contentAccessLogs/{userId} {
      allow read, write: if false;

      match /counts/{countId} {
        allow read, write: if false;
      }

      match /minutes/{minuteId} {
        allow read, write: if false;
      }
    }

    // ============================================
    // GAMIFICAÇÃO — ENGAJAMENTO
    // ============================================
    match /dailyRewards/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow write: if false;
    }

    match /dailyFaisca/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow write: if false;
    }

    match /destinyCards/{uid} {
      allow read: if isAuthenticated() && isOwner(uid);
      allow write: if false;
    }

    match /dailyMissions/{docId} {
      // resource == null: o documento do dia ainda não existe. A
      // Home escuta antes de ele ser gerado; sem isto a escuta era
      // negada, morria, e o contador ficava parado em 0.
      allow read: if isAuthenticated() &&
        (resource == null || resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Quem está por trás de um gatilho emocional. Só o servidor lê:
    // a revelação é paga e feita pela CF revealTrigger.
    match /triggerSecrets/{notificationId} {
      allow read, write: if false;
    }

    // Lista de espera do Destaque Regional — só o servidor.
    match /destaqueWaitlist/{id} {
      allow read, write: if false;
    }

    match /xpLog/{logId} {
      allow read: if isAuthenticated() &&
        resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /xpIdempotency/{key} {
      allow read:  if false;
      allow write: if false;
    }

    match /economyLedger/{logId} {
      allow read:  if false;
      allow write: if false;
    }

    match /shadowComparisons/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    match /systemConfig/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
match /achievementTriggers/{docId} {
  allow read:  if false;
  allow write: if false;
}
    // ============================================
    // GAMIFICAÇÃO — CONTROLES INTERNOS
    // ============================================
    match /triggerControl/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    match /pendingLostSintonia/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    // ============================================
    // CONFIGURAÇÃO INTERNA — fechada ao cliente
    // ============================================
    // internalConfig/admins guarda a lista de superadmins.
    //
    // Antes ela vivia em appSettings/adminConfig, e appSettings
    // tem `allow read: if true`: QUALQUER PESSOA, até sem login,
    // descobria quem são os superadmins do Lumina e depois lia o
    // pushToken deles pela coleção users.
    //
    // A regra explícita fica aqui mesmo com o deny padrão do
    // Firestore cobrindo: sem ela, a ausência parece
    // esquecimento e alguém abre a coleção sem saber o histórico.
    match /internalConfig/{docId} {
      allow read:  if false;
      allow write: if false;
    }

    // ============================================
    // CONTADORES INTERNOS
    // ============================================
    // counters/founders guarda quantas vagas de Fundador foram
    // usadas. Fechado nos dois sentidos: leitura aberta
    // permitiria descobrir o número exato e escrita permitiria
    // zerar o limite.
    match /counters/{counterId} {
      allow read:  if false;
      allow write: if false;
    }

    // ============================================
    // VERIFICAÇÃO DE IDADE
    // ============================================
    // Fechado ao cliente nos dois sentidos. O usuário NÃO lê
    // o próprio documento: o status que ele precisa ver é
    // espelhado em users/{uid}.ageVerificationStatus, que já
    // é lido pelo useUserPermissions com onSnapshot.
    //
    // Leitura fechada também para o admin: a fila vem da CF
    // listPendingVerifications, que devolve URLs assinadas
    // curtas em vez de expor os caminhos do Storage.
    match /ageVerifications/{userId} {
      allow read:  if false;
      allow write: if false;
    }

    // ============================================
    // ACEITE DOS TERMOS — prova de consentimento
    // ============================================
    // Escrita exclusiva da CF acceptAppTerms. O usuário lê o
    // próprio histórico (direito de acesso, LGPD art. 18) mas
    // nunca escreve: consentimento auto-declarado não é prova.
    match /termsAcceptances/{userId} {
      
      allow read:  if isOwner(userId) || isSuperAdmin();
      allow write: if false;

      match /history/{version} {
        allow read:  if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }
    }

    // ============================================
    // CONTRATO DO CRIADOR E DECLARAÇÕES DE PRODUTO (12/10/2026)
    // ============================================
    // Escrita exclusiva das CFs acceptCreatorContract,
    // submitProductForReview e submitProductChanges. O criador lê a
    // própria situação (o app decide se mostra o contrato) e o próprio
    // histórico (direito de acesso, LGPD art. 18); nunca escreve —
    // aceite auto-gravado não é prova.
    match /creatorAgreements/{userId} {
      allow read:  if isOwner(userId) || isSuperAdmin();
      allow write: if false;

      match /history/{entryId} {
        allow read:  if isOwner(userId) || isSuperAdmin();
        allow write: if false;
      }
    }

    // ============================================
    // EXCLUSÃO DE CONTA — só o servidor
    // ============================================
    // Pedido (accountDeletions/{uid}) e comprovante pseudônimo
    // (accountDeletionLog/{anonId}). Ver functions/src/users/
    // accountDeletion.ts.
    // Corrigido em 08/10/2026: estes dois blocos estavam DENTRO de
    // termsAcceptances/{userId}/history/{version}, ou seja, valiam
    // para um caminho que não existe. As coleções reais já estavam
    // fechadas pelo bloqueio padrão do Firestore; agora a regra
    // explícita está no lugar certo.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }
    match /accountDeletionLog/{anonId} {
      allow read, write: if false;
    }

  }
}
